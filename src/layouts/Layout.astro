---
import "../styles/global.css";
import { withBase } from "../lib/withBase";

const { themeClass, meta } = Astro.props;
const faviconUrl = withBase("favicon/favicon.svg?v=2");
const faviconPngUrl = withBase("favicon/favicon-32x32.png?v=2");
const faviconIcoUrl = withBase("favicon/favicon.ico?v=2");
const appleTouchIconUrl = withBase("favicon/apple-touch-icon.png?v=2");
const manifestUrl = withBase("manifest.webmanifest");
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{meta.title}</title>
		<meta name="description" content={meta.description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={faviconUrl} />
		<link rel="icon" type="image/png" sizes="32x32" href={faviconPngUrl} />
		<link rel="icon" href={faviconIcoUrl} sizes="any" />
		<link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconUrl} />
		<link rel="manifest" href={manifestUrl} />
		<meta name="theme-color" content="#7C3AED" />
		<meta property="og:title" content={meta.title} />
		<meta property="og:description" content={meta.description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={meta.url_base} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={meta.title} />
		<meta name="twitter:description" content={meta.description} />
		<link rel="canonical" href={meta.url_base} />
		<script
			is:inline
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-59XYM34GSR"
		></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'G-59XYM34GSR');
		</script>
	</head>
	<body class={`min-h-screen ${themeClass.background}`}>
		<div class="container max-w-md mx-auto px-4 py-8">
			<header><slot name="header" /></header>
			<main><slot /></main>
		</div>
		<footer><slot name="footer" /></footer>
	</body>
</html>
